# ---------------------------------------------------------------------------
# Focuspond environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project URL (safe to expose to the browser).
# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_FOCUSPOND_BASE_URL="https://your-project-ref.supabase.co"

# Supabase anon/public key (safe to expose to the browser).
# Supabase dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_FOCUSPOND_ANON_KEY="your-anon-public-key"

# Supabase service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC.
# Full read/write access that bypasses Row Level Security. Keep it secret.
# Supabase dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_FOCUSPOND_SERVICE_ROLE_KEY="your-service-role-key"
